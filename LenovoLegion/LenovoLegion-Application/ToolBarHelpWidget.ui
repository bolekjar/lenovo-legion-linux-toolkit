<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>ToolBarHelpWidget</class>
 <widget class="QWidget" name="ToolBarHelpWidget">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1986</width>
    <height>1594</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Help</string>
  </property>
  <property name="styleSheet">
   <string notr="true"/>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout_Main">
   <item>
    <widget class="QScrollArea" name="scrollArea">
     <property name="widgetResizable">
      <bool>true</bool>
     </property>
     <widget class="QWidget" name="scrollAreaWidgetContents">
      <property name="geometry">
       <rect>
        <x>0</x>
        <y>0</y>
        <width>1966</width>
        <height>1574</height>
       </rect>
      </property>
      <layout class="QVBoxLayout" name="verticalLayout">
       <item>
        <layout class="QVBoxLayout" name="verticalLayout_Content">
         <item>
          <widget class="QGroupBox" name="groupBox_Overview">
           <property name="title">
            <string>Overview</string>
           </property>
           <layout class="QVBoxLayout" name="verticalLayout_Overview">
            <property name="topMargin">
             <number>20</number>
            </property>
            <item>
             <widget class="QLabel" name="label_Overview">
              <property name="text">
               <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p align=&quot;justify&quot;&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Lenovo Legion Linux Toolkit&lt;/span&gt; is a comprehensive system management tool for Lenovo Legion laptops running Linux. It provides detailed hardware monitoring and control over CPU, GPU, cooling, and power management features. It consists of a kernel driver, a daemon that communicates with the kernel driver, and a GUI interface that communicates with the daemon. The kernel driver uses the WMI interface and allows you to set and define limits on the motherboard. The daemon is directly connected to the kernel driver via the sysfs interface or via the CUDA interface for NVIDIA GPUs. The GUI is connected to the daemon and gives commands to the daemon to individual drivers to change their parameters.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
              </property>
              <property name="wordWrap">
               <bool>true</bool>
              </property>
             </widget>
            </item>
           </layout>
          </widget>
         </item>
         <item>
          <widget class="QGroupBox" name="groupBox_Home">
           <property name="title">
            <string>Home Tab</string>
           </property>
           <layout class="QVBoxLayout" name="verticalLayout_Home">
            <property name="topMargin">
             <number>20</number>
            </property>
            <item>
             <widget class="QLabel" name="label_Home">
              <property name="text">
               <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Power Profile Control:&lt;/span&gt; Select from Quiet, Balanced, Performance, Custom, or Extreme modes. Affects CPU behavior, fan speeds, and power consumption. ACPI platform profile integration. &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Hardware Monitoring: &lt;/span&gt;Real-time display of CPU/GPU temperatures, frequencies, power draw, utilization, and all system sensors. Expandable CPU and GPU details windows. &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;CPU Control:&lt;/span&gt; Individual control per core/thread. Set governor (performance, powersave, ondemand), enable/disable cores, manage SMT (Hyper-Threading). Separate P-core and E-core management on hybrid CPUs. &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;CPU Frequency Control:&lt;/span&gt; Set minimum and maximum frequency limits per thread. Apply to all cores or individually. Real-time frequency monitoring. &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Power Control: &lt;/span&gt;CPU: Configure PL1/PL2 (TDP limits), PL1 Tau (turbo duration), boost control, cross-load limits, CPU temperature limit. GPU: Set TGP (Total Graphics Power), boost clock, GPU temperature limit. Preset configurations available.&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Fan Control: &lt;/span&gt;Create custom 10-point fan curves. Max fan speed override. Lock fan controller. Real-time temperature monitoring. Auto-normalization of curve points. &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Voltage Offsets Control:&lt;/span&gt; Intel MSR-based undervolting: Core, Uncore, Cache, iGPU, and Analog I/O voltage offsets. NVIDIA GPU: Core and memory clock offsets. Safety presets included.&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Other Settings:&lt;/span&gt; It allows you to control the laptop's hardware like a keyboard. Next are the GPU modes and finally the CPU power state.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
              </property>
              <property name="textFormat">
               <enum>Qt::TextFormat::RichText</enum>
              </property>
              <property name="wordWrap">
               <bool>true</bool>
              </property>
             </widget>
            </item>
           </layout>
          </widget>
         </item>
         <item>
          <widget class="QGroupBox" name="groupBox_Information">
           <property name="title">
            <string>Information Tab</string>
           </property>
           <layout class="QVBoxLayout" name="verticalLayout_Information">
            <property name="topMargin">
             <number>20</number>
            </property>
            <item>
             <widget class="QLabel" name="label_Information">
              <property name="text">
               <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;System&lt;/span&gt;: System vendor/manufacturer. &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Product&lt;/span&gt;: Name, family, SKU, version (e.g., Legion 5 Pro, 82WM). &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;BIOS&lt;/span&gt;: Vendor, version, release number, date. &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Board&lt;/span&gt;: Motherboard name, vendor, version. &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Chassis&lt;/span&gt;: Type (laptop/notebook), vendor, version. &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;CPU&lt;/span&gt;: Model (e.g., Intel Core i9-14900HX), generation, architecture (x86_64), cache hierarchy (L1/L2/L3). &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;GPU&lt;/span&gt;: Name (e.g., NVIDIA RTX 4070), power limits (min/max/default).&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
              </property>
              <property name="textFormat">
               <enum>Qt::TextFormat::RichText</enum>
              </property>
              <property name="wordWrap">
               <bool>true</bool>
              </property>
             </widget>
            </item>
           </layout>
          </widget>
         </item>
         <item>
          <widget class="QGroupBox" name="groupBox_Features">
           <property name="title">
            <string>Key Features</string>
           </property>
           <layout class="QVBoxLayout" name="verticalLayout_Features">
            <property name="topMargin">
             <number>20</number>
            </property>
            <item>
             <widget class="QLabel" name="label_Features">
              <property name="text">
               <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Real-time Monitoring:&lt;/span&gt; 500ms refresh rate. All hwmon sensors, Intel RAPL power monitoring, NVIDIA NVML GPU metrics, per-core frequencies. &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Hybrid CPU Support:&lt;/span&gt; Automatic detection of P-cores (Performance) and E-cores (Efficiency) on Intel 12th gen+. Visual distinction and individual control. &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Lenovo Driver Integration: &lt;/span&gt;Native support for Lenovo Legion WMI interface (fan control, power profiles, rapid charge). Falls back to ACPI when unavailable. &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Battery Management:&lt;/span&gt; Charge level, health, cycle count, voltage, current, power draw, charge/discharge rate, estimated runtime. &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Safety Features:&lt;/span&gt; Change detection and confirmation, automatic validation, preset configurations, real-time warnings.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
              </property>
              <property name="textFormat">
               <enum>Qt::TextFormat::RichText</enum>
              </property>
              <property name="wordWrap">
               <bool>true</bool>
              </property>
             </widget>
            </item>
           </layout>
          </widget>
         </item>
         <item>
          <widget class="QGroupBox" name="groupBox_Settings">
           <property name="title">
            <string>Settings Tab</string>
           </property>
           <layout class="QVBoxLayout" name="verticalLayout_Settings">
            <property name="topMargin">
             <number>20</number>
            </property>
            <item>
             <widget class="QLabel" name="label_Settings">
              <property name="text">
               <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Application Settings: &lt;/span&gt;Start on boot, start minimized to tray, minimize to tray on close, notification preferences, UI theme. &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Profile Management:&lt;/span&gt; Save current configuration as named profile. Import/export profiles as JSON files. Quick switching between saved configurations. Profile includes: power profile, CPU settings, fan curves, voltage offsets. &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Daemon Configuration:&lt;/span&gt; Connection timeout, retry interval, auto-reconnect. View daemon status and logs. &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Advanced Options:&lt;/span&gt; Enable debug logging, experimental features, force unsafe operations (requires confirmation). Reset to defaults.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
              </property>
              <property name="textFormat">
               <enum>Qt::TextFormat::RichText</enum>
              </property>
              <property name="wordWrap">
               <bool>true</bool>
              </property>
             </widget>
            </item>
           </layout>
          </widget>
         </item>
         <item>
          <widget class="QGroupBox" name="groupBox_Requirements">
           <property name="title">
            <string>System Requirements</string>
           </property>
           <layout class="QVBoxLayout" name="verticalLayout_Requirements">
            <property name="topMargin">
             <number>20</number>
            </property>
            <item>
             <widget class="QLabel" name="label_Requirements">
              <property name="text">
               <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;OS:&lt;/span&gt; Linux kernel 5.0+ (5.17+ recommended for full ACPI platform profile support) &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Hardware:&lt;/span&gt; Lenovo Legion laptop (tested on 5/7 Pro series) &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Daemon:&lt;/span&gt; LenovoLegion-Daemon systemd service running with root privileges &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Kernel Modules:&lt;/span&gt; cpufreq, msr, hwmon, ideapad_laptop or legion_laptop &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Optional:&lt;/span&gt; NVIDIA proprietary drivers (535+) and libnvidia-ml for GPU features &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Build: &lt;/span&gt;Qt 5.15+, protobuf 3.0+, cmake 3.16+&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
              </property>
              <property name="textFormat">
               <enum>Qt::TextFormat::RichText</enum>
              </property>
              <property name="wordWrap">
               <bool>true</bool>
              </property>
             </widget>
            </item>
           </layout>
          </widget>
         </item>
         <item>
          <widget class="QGroupBox" name="groupBox_Tips">
           <property name="title">
            <string>Tips &amp; Best Practices</string>
           </property>
           <layout class="QVBoxLayout" name="verticalLayout_Tips">
            <property name="topMargin">
             <number>20</number>
            </property>
            <item>
             <widget class="QLabel" name="label_Tips">
              <property name="text">
               <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Undervolting: &lt;/span&gt;Start with -50mV on core/cache, test stability with stress tests (prime95, stress-ng). Decrease by -10mV increments if unstable. Can reduce temps by 10-15°C. &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Fan Curves: &lt;/span&gt;Balance noise vs cooling. Typical points: 30°C→30%, 50°C→40%, 70°C→60%, 85°C→80%, 95°C→100%. Ensure monotonic increase (later points ≥ earlier). &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Power Limits:&lt;/span&gt; Lowering PL1/PL2 reduces heat and noise with minimal performance loss. For gaming: PL1=45W, PL2=65W is good balance. For productivity: PL1=35W, PL2=55W extends battery. &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Battery Life:&lt;/span&gt; Quiet mode + disable E-cores on Intel 12th+ + 1.5-2.0 GHz max freq + lower screen brightness = 2-3x runtime. &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Thermal Throttling: &lt;/span&gt;If temps hit 100°C, lower PL2, improve cooling (laptop stand, clean fans), or reduce max frequency to 4.0-4.5 GHz.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
              </property>
              <property name="textFormat">
               <enum>Qt::TextFormat::RichText</enum>
              </property>
              <property name="wordWrap">
               <bool>true</bool>
              </property>
             </widget>
            </item>
           </layout>
          </widget>
         </item>
         <item>
          <spacer name="verticalSpacer">
           <property name="orientation">
            <enum>Qt::Orientation::Vertical</enum>
           </property>
           <property name="sizeHint" stdset="0">
            <size>
             <width>20</width>
             <height>40</height>
            </size>
           </property>
          </spacer>
         </item>
        </layout>
       </item>
      </layout>
     </widget>
    </widget>
   </item>
  </layout>
 </widget>
 <resources/>
