          </item>
          <item>
           <layout class="QVBoxLayout" name="verticalLayout_4">
            <item>
             <widget class="QLabel" name="label_CPUPState_MAXLimit">
              <property name="toolTip">
               <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Maximum performance limit for your CPU, working hand-in-hand with the no_turbo switch you just looVked at.&lt;/p&gt;&lt;p&gt;Controls the maximum allowed frequency (P-state) as a percentage of the total hardware capability.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
              </property>
              <property name="text">
               <string>MAX Performace limit [%]</string>
              </property>
             </widget>
            </item>
            <item>
