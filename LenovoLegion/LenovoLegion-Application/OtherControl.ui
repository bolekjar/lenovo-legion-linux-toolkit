          <item>
           <layout class="QVBoxLayout" name="verticalLayout_5">
            <item>
             <widget class="QLabel" name="label_CPUPState_MINLimit">
              <property name="toolTip">
               <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;This file dictates the minimum allowed frequency (P-state) that the intel_pstate driver can drop to, expressed as a percentage of the maximum hardware capability.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
