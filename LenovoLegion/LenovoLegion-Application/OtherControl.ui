        </item>
        <item>
         <layout class="QHBoxLayout" name="horizontalLayout_4">
          <item>
           <widget class="QCheckBox" name="checkBox_CPUPStatedisableTurbo">
            <property name="toolTip">
             <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Is the standard, used in the Linux kernel to control Turbo Boost.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
            </property>
            <property name="text">
             <string>Disable Turbo</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="checkBox_CPUPStatehwpDynamicBoost">
            <property name="toolTip">
             <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;When enabled, this feature briefly and dynamically boosts processor performance (P-state) the moment a task resumes after waiting for disk or network operations to complete (I/O wait).&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;The Goal: &lt;/span&gt;To speed up system responsiveness. While the processor is waiting for data from the disk, it runs at a low frequency to save power. As soon as the disk delivers the data, HWP Dynamic Boost immediately &amp;quot;pushes&amp;quot; the processor to a higher clock speed so the data can be processed without any stutter.&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;When it is useful:&lt;/span&gt; It helps primarily with applications that read and write heavily to the disk, or network services where the lowest possible response time (latency) matters.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
            </property>
            <property name="text">
             <string>HWP Dynamic boost</string>
            </property>
           </widget>
          </item>
         </layout>
        </item>
        <item>
         <layout class="QHBoxLayout" name="horizontalLayout">
          <item>
           <widget class="QPushButton" name="pushButton_CPUPState_Default">
            <property name="text">
             <string>Default</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="pushButton_CPUPState_Cancel">
            <property name="text">
             <string>Cancel</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="pushButton_CPUPState_Apply">
            <property name="text">
             <string>Apply</string>
            </property>
           </widget>
          </item>
          <item>
           <layout class="QHBoxLayout" name="horizontalLayout_3">
            <item>
             <widget class="QLabel" name="label__CPUPstate_status">
              <property name="text">
               <string>Mode:</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QComboBox" name="comboBox_CPUPstate_status">
              <property name="toolTip">
               <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;🟢 Active Mode (Default for Modern CPUs) - In this mode, the Linux kernel hands over frequency scaling control directly to the processor's hardware (HWP - Hardware P-States). &lt;/p&gt;&lt;p&gt;🔵 Passive Mode In this mode, the driver operates similarly to older, generic scaling drivers (like &lt;span style=&quot; font-family:'monospace'; font-size:14px;&quot;&gt;acpi-cpufreq&lt;/span&gt;).&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
              </property>
             </widget>
            </item>
           </layout>
          </item>
         </layout>
        </item>
