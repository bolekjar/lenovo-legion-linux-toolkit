#-------------------------------------------------
#
# Protocol messages (protobuf) shared by the daemon, daemon modules and the GUI.
#
# Must be a shared library: every message may be registered in the protobuf
# descriptor pool only once per process, linking the same *.pb.cc into the daemon
# and into a module (.so) aborts the daemon on dlopen ("File already exists in database").
#
# Messages are generated by LenovoLegion-PrepareBuild (protoc).
#
#-------------------------------------------------
TEMPLATE        = lib
TARGET          = LenovoLegionMessages

# plugin: plain libLenovoLegionMessages.so, no version symlinks
CONFIG          += c++20 link_pkgconfig plugin

QT              -=  core gui

PKGCONFIG       += protobuf

# Next to the daemon and the GUI, found by rpath $ORIGIN
DESTDIR         = $${DESTINATION_BIN_PATH}

MESSAGES_PATH   = $$PWD/../LenovoLegion-PrepareBuild

INCLUDEPATH     = $${MESSAGES_PATH}

HEADERS += \
        $${MESSAGES_PATH}/HWMonitoring.pb.h \
        $${MESSAGES_PATH}/CPUTopology.pb.h \
        $${MESSAGES_PATH}/PowerProfile.pb.h \
        $${MESSAGES_PATH}/Battery.pb.h \
        $${MESSAGES_PATH}/CpuPower.pb.h \
        $${MESSAGES_PATH}/GPUPower.pb.h \
        $${MESSAGES_PATH}/FanControl.pb.h \
        $${MESSAGES_PATH}/CPUFrequency.pb.h \
        $${MESSAGES_PATH}/CPUOptions.pb.h \
        $${MESSAGES_PATH}/Notification.pb.h \
        $${MESSAGES_PATH}/CpuIntelMSR.pb.h \
        $${MESSAGES_PATH}/NvidiaNvml.pb.h \
        $${MESSAGES_PATH}/ComputerInfo.pb.h \
        $${MESSAGES_PATH}/DaemonSettings.pb.h \
        $${MESSAGES_PATH}/Profiles.pb.h \
        $${MESSAGES_PATH}/Other.pb.h \
        $${MESSAGES_PATH}/RGBController.pb.h \
        $${MESSAGES_PATH}/MessageRegistry.pb.h

SOURCES += \
        $${MESSAGES_PATH}/HWMonitoring.pb.cc \
        $${MESSAGES_PATH}/CPUTopology.pb.cc \
        $${MESSAGES_PATH}/PowerProfile.pb.cc \
        $${MESSAGES_PATH}/Battery.pb.cc \
        $${MESSAGES_PATH}/CpuPower.pb.cc \
        $${MESSAGES_PATH}/GPUPower.pb.cc \
        $${MESSAGES_PATH}/FanControl.pb.cc \
        $${MESSAGES_PATH}/CPUFrequency.pb.cc \
        $${MESSAGES_PATH}/CPUOptions.pb.cc \
        $${MESSAGES_PATH}/Notification.pb.cc \
        $${MESSAGES_PATH}/CpuIntelMSR.pb.cc \
        $${MESSAGES_PATH}/NvidiaNvml.pb.cc \
        $${MESSAGES_PATH}/ComputerInfo.pb.cc \
        $${MESSAGES_PATH}/DaemonSettings.pb.cc \
        $${MESSAGES_PATH}/Profiles.pb.cc \
        $${MESSAGES_PATH}/Other.pb.cc \
        $${MESSAGES_PATH}/RGBController.pb.cc \
        $${MESSAGES_PATH}/MessageRegistry.pb.cc
